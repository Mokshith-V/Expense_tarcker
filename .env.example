# Copy this file to ".env" and fill in your own values.
# .env holds secrets: never commit it to Git (it is already in .gitignore).

# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password contains "@", write it as "%40" (e.g. pass@123 -> pass%40123).
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/expense_tracker

# Only for a hosted MySQL that requires SSL (e.g. Aiven): the CA certificate file,
# relative to the project folder. Leave it out for local MySQL.
# DATABASE_SSL_CA=ca.pem

# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here

ACCESS_TOKEN_EXPIRE_MINUTES=60
